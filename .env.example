# Application Runtime Configuration
NODE_ENV="development"
PORT="3000"
APP_URL="http://localhost:3000"

# Session & Security Secrets (generate strong random strings in production)
SESSION_SECRET="CHANGE_ME_TO_A_STRONG_64_CHAR_RANDOM_SECRET"

# Database Configuration
# Local persistent SQLite database path (default in AI Studio runtime)
SQLITE_DB_PATH="./data/hit_civil_library.db"

# Institutional PostgreSQL + Prisma Deployment (for departmental server deployment)
# DATABASE_URL="postgresql://hit_lib_user:CHANGE_ME@localhost:5432/hit_civil_library?schema=public"

# Optional Email Notification SMTP Configuration (disabled by default)
SMTP_ENABLED="false"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="library.ce@hithaldia.ac.in"

# Initial Super Administrator Setup (used only on first empty-database initialization)
# Set via environment in production; never commit real passwords
INITIAL_ADMIN_EMAIL="admin.ce@hithaldia.ac.in"
INITIAL_ADMIN_PASSWORD="CHANGE_ME_ON_FIRST_DEPLOY"

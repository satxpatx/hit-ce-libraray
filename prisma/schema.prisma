// HIT Civil Engineering – Digital Library Management System
// Complete Normalized PostgreSQL + Prisma ORM Schema (28 Models)
// Institution: Haldia Institute of Technology, Department of Civil Engineering

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  SUPER_ADMIN
  LIBRARIAN
  FACULTY
  STUDENT
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CopyStatus {
  AVAILABLE
  ISSUED
  RESERVED
  UNDER_MAINTENANCE
  LOST
  DAMAGED
  WITHDRAWN
}

enum IssueStatus {
  ISSUED
  RETURNED
  OVERDUE
  LOST
}

enum ReservationStatus {
  ACTIVE
  READY
  FULFILLED
  CANCELLED
  EXPIRED
}

enum FinePaymentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  WAIVED
}

enum AcquisitionStatus {
  PENDING
  APPROVED
  REJECTED
  PURCHASED
}

enum PriorityLevel {
  LOW
  MEDIUM
  HIGH
}

model Role {
  id          Int              @id @default(autoincrement())
  name        RoleName         @unique
  description String?
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime         @default(now())
}

model Permission {
  id          Int              @id @default(autoincrement())
  code        String           @unique
  module      String
  description String
  roles       RolePermission[]
}

model RolePermission {
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Department {
  id          Int       @id @default(autoincrement())
  code        String    @unique
  name        String
  hodName     String?
  location    String?
  users       User[]
  students    Student[]
  faculties   Faculty[]
  createdAt   DateTime  @default(now())
}

model User {
  id                  Int                  @id @default(autoincrement())
  firebaseUid         String?              @unique
  email               String               @unique
  passwordHash        String
  fullName            String
  phone               String?
  photoUrl            String?
  roleId              Int
  role                Role                 @relation(fields: [roleId], references: [id])
  departmentId        Int?
  department          Department?          @relation(fields: [departmentId], references: [id])
  status              AccountStatus        @default(ACTIVE)
  isDemoData          Boolean              @default(false)
  student             Student?
  faculty             Faculty?
  issuedLoans         BookIssue[]          @relation("BorrowerIssues")
  processedIssues     BookIssue[]          @relation("StaffIssues")
  reservations        Reservation[]
  fines               Fine[]
  acquisitionRequests AcquisitionRequest[]
  digitalResources    DigitalResource[]
  notifications       Notification[]
  importJobs          ImportJob[]
  auditLogs           AuditLog[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([roleId])
  @@index([status])
}

model Student {
  id                 Int        @id @default(autoincrement())
  userId             Int        @unique
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  registrationNumber String     @unique
  programme          String
  semester           Int
  academicSession    String
  departmentId       Int
  department         Department @relation(fields: [departmentId], references: [id])
  createdAt          DateTime   @default(now())

  @@index([registrationNumber])
}

model Faculty {
  id           Int        @id @default(autoincrement())
  userId       Int        @unique
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeId   String     @unique
  designation  String
  departmentId Int
  department   Department @relation(fields: [departmentId], references: [id])
  createdAt    DateTime   @default(now())

  @@index([employeeId])
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  code        String   @unique
  description String?
  isStandard  Boolean  @default(false)
  books       Book[]
  createdAt   DateTime @default(now())
}

model Author {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  biography String?
  books     Book[]
  createdAt DateTime @default(now())
}

model Publisher {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  city      String?
  country   String?
  website   String?
  books     Book[]
  createdAt DateTime @default(now())
}

model Book {
  id                  Int                @id @default(autoincrement())
  bookCode            String             @unique
  isbn                String?            @unique
  title               String
  subtitle            String?
  authorId            Int
  author              Author             @relation(fields: [authorId], references: [id])
  editor              String?
  publisherId         Int
  publisher           Publisher          @relation(fields: [publisherId], references: [id])
  edition             String?
  publicationYear     Int?
  language            String             @default("English")
  subject             String
  categoryId          Int
  category            Category           @relation(fields: [categoryId], references: [id])
  subcategory         String?
  description         String?
  keywords            String?
  coverImageUrl       String?
  digitalAttachment   String?
  archived            Boolean            @default(false)
  isDemoData          Boolean            @default(false)
  copies              BookCopy[]
  reservations        Reservation[]
  reservationQueues   ReservationQueue[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([title])
  @@index([isbn])
  @@index([categoryId])
}

model AccessionSequence {
  id          Int      @id @default(autoincrement())
  prefix      String   @default("HIT-CE")
  yearFormat  String   @default("CALENDAR")
  currentYear Int
  lastNumber  Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([prefix, currentYear])
}

model BookCopy {
  id                Int         @id @default(autoincrement())
  accessionNumber   String      @unique
  bookId            Int
  book              Book        @relation(fields: [bookId], references: [id])
  copyNumber        Int
  acquisitionDate   DateTime    @default(now())
  purchasePriceInr  Decimal     @db.Decimal(10, 2)
  supplier          String?
  invoiceNumber     String?
  fundingSource     String?
  shelfNumber       String
  rackNumber        String
  physicalCondition String      @default("Good")
  status            CopyStatus  @default(AVAILABLE)
  remarks           String?
  isDemoData        Boolean     @default(false)
  barcode           Barcode?
  qrCode            QRCode?
  issues            BookIssue[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([accessionNumber])
  @@index([bookId])
  @@index([status])
}

model Barcode {
  id         Int      @id @default(autoincrement())
  bookCopyId Int      @unique
  bookCopy   BookCopy @relation(fields: [bookCopyId], references: [id], onDelete: Cascade)
  format     String   @default("CODE128")
  value      String   @unique
  createdAt  DateTime @default(now())
}

model QRCode {
  id         Int      @id @default(autoincrement())
  bookCopyId Int      @unique
  bookCopy   BookCopy @relation(fields: [bookCopyId], references: [id], onDelete: Cascade)
  payload    String   @unique
  createdAt  DateTime @default(now())
}

model BookIssue {
  id           Int           @id @default(autoincrement())
  receiptNo    String        @unique
  bookCopyId   Int
  bookCopy     BookCopy      @relation(fields: [bookCopyId], references: [id])
  borrowerId   Int
  borrower     User          @relation("BorrowerIssues", fields: [borrowerId], references: [id])
  issuedById   Int
  issuedBy     User          @relation("StaffIssues", fields: [issuedById], references: [id])
  issueDate    DateTime      @default(now())
  dueDate      DateTime
  status       IssueStatus   @default(ISSUED)
  renewalCount Int           @default(0)
  remarks      String?
  isDemoData   Boolean       @default(false)
  bookReturn   BookReturn?
  renewals     BookRenewal[]
  fines        Fine[]
  createdAt    DateTime      @default(now())

  @@index([bookCopyId, status])
  @@index([borrowerId, status])
  @@index([dueDate])
}

model BookReturn {
  id            Int       @id @default(autoincrement())
  bookIssueId   Int       @unique
  bookIssue     BookIssue @relation(fields: [bookIssueId], references: [id])
  returnReceipt String    @unique
  returnDate    DateTime  @default(now())
  overdueDays   Int       @default(0)
  fineAmountInr Decimal   @default(0) @db.Decimal(10, 2)
  conditionNote String?
  processedBy   Int
  createdAt     DateTime  @default(now())
}

model BookRenewal {
  id             Int       @id @default(autoincrement())
  bookIssueId    Int
  bookIssue      BookIssue @relation(fields: [bookIssueId], references: [id])
  previousDue    DateTime
  newDueDate     DateTime
  renewedById    Int
  renewalDate    DateTime  @default(now())
}

model Reservation {
  id             Int               @id @default(autoincrement())
  bookId         Int
  book           Book              @relation(fields: [bookId], references: [id])
  userId         Int
  user           User              @relation(fields: [userId], references: [id])
  status         ReservationStatus @default(ACTIVE)
  reservedAt     DateTime          @default(now())
  expiresAt      DateTime?
  queue          ReservationQueue?
}

model ReservationQueue {
  id            Int         @id @default(autoincrement())
  reservationId Int         @unique
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  bookId        Int
  book          Book        @relation(fields: [bookId], references: [id])
  position      Int
  updatedAt     DateTime    @updatedAt
}

model Fine {
  id             Int               @id @default(autoincrement())
  bookIssueId    Int
  bookIssue      BookIssue         @relation(fields: [bookIssueId], references: [id])
  userId         Int
  user           User              @relation(fields: [userId], references: [id])
  overdueDays    Int
  amountInr      Decimal           @db.Decimal(10, 2)
  paidAmountInr  Decimal           @default(0) @db.Decimal(10, 2)
  waivedAmount   Decimal           @default(0) @db.Decimal(10, 2)
  status         FinePaymentStatus @default(PENDING)
  waiverReason   String?
  payments       FinePayment[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model FinePayment {
  id             Int      @id @default(autoincrement())
  fineId         Int
  fine           Fine     @relation(fields: [fineId], references: [id], onDelete: Cascade)
  receiptNumber  String   @unique
  amountPaidInr  Decimal  @db.Decimal(10, 2)
  paymentMethod  String   @default("Cash / Departmental Counter")
  collectedById  Int
  paidAt         DateTime @default(now())
}

model AcquisitionRequest {
  id          Int               @id @default(autoincrement())
  title       String
  author      String
  isbn        String?
  publisher   String?
  subject     String
  reason      String
  requesterId Int
  requester   User              @relation(fields: [requesterId], references: [id])
  priority    PriorityLevel     @default(MEDIUM)
  status      AcquisitionStatus @default(PENDING)
  reviewNote  String?
  isDemoData  Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model DigitalResource {
  id              Int      @id @default(autoincrement())
  title           String
  author          String
  category        String
  subject         String
  semester        String?
  academicYear    String
  description     String?
  fileName        String
  filePath        String
  fileSizeBytes   Int
  mimeType        String
  accessLevel     String   @default("ALL_AUTHENTICATED")
  uploadedById    Int
  uploadedBy      User     @relation(fields: [uploadedById], references: [id])
  downloadCount   Int      @default(0)
  isDemoData      Boolean  @default(false)
  createdAt       DateTime @default(now())
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

model ImportJob {
  id            Int           @id @default(autoincrement())
  fileName      String
  sheetName     String
  duplicateMode String
  totalRows     Int
  importedRows  Int
  skippedRows   Int
  errorRows     Int
  uploadedById  Int
  uploadedBy    User          @relation(fields: [uploadedById], references: [id])
  errors        ImportError[]
  createdAt     DateTime      @default(now())
}

model ImportError {
  id          Int       @id @default(autoincrement())
  importJobId Int
  importJob   ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  rowNumber   Int
  fieldName   String
  reason      String
  rawPayload  String
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  actorId    Int?
  actor      User?    @relation(fields: [actorId], references: [id])
  actorRole  String
  action     String
  entityType String
  entityId   String?
  details    String
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType])
}

model InstitutionSettings {
  id                       Int      @id @default(autoincrement())
  institutionName          String   @default("Haldia Institute of Technology")
  departmentName           String   @default("Department of Civil Engineering")
  location                 String   @default("Haldia, West Bengal, India")
  applicationName          String   @default("HIT Civil Engineering – Digital Library")
  tagline                  String   @default("Knowledge. Research. Innovation.")
  academicSession          String   @default("2026-2027")
  institutionLogoUrl       String?
  departmentLogoUrl        String?
  accessionPrefix          String   @default("HIT-CE")
  accessionYearFormat      String   @default("CALENDAR")
  accessionStartSequence   Int      @default(1)
  studentBorrowLimit       Int      @default(4)
  facultyBorrowLimit       Int      @default(8)
  studentLoanDays          Int      @default(14)
  facultyLoanDays          Int      @default(30)
  maxRenewals              Int      @default(2)
  finePerDayInr            Decimal  @default(5.00) @db.Decimal(8, 2)
  maxFineInr               Decimal  @default(500.00) @db.Decimal(8, 2)
  reservationExpiryHours   Int      @default(48)
  emailNotificationsOn     Boolean  @default(false)
  updatedAt                DateTime @updatedAt
}
